{
  "expo": {
    "name": "SubTrack",
    "slug": "subtrack",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/SubtrackIcon.png",
    "scheme": "subtrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3AABCC"
    },
    "privacy": "public",
    "description": "SubTrack is a comprehensive subscription management app that helps you track both fixed subscriptions (Netflix, Spotify) and variable recurring bills (utilities, phone). Features include payment reminders, spending analytics, calendar integration, and secure cloud sync. Take control of your recurring expenses with intuitive charts and customizable notifications.",
    "githubUrl": "https://github.com/Zeff01/SubTrack",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codebility.subtrack",
      "buildNumber": "1",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSCameraUsageDescription": "This app does not use the camera.",
        "NSMicrophoneUsageDescription": "This app does not use the microphone.",
        "NSPhotoLibraryUsageDescription": "This app does not access the photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3AABCC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.codebility.subtrack",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3AABCC"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/SubtrackIcon.png",
          "color": "#3AABCC",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe768ce9-06c2-46da-9a10-ceebf7161ddc"
      }
    },
    "owner": "zeff01"
  }
}
